#: apps/core/greetings.py:29
#, python-format
msgid "Good morning, %(username)s! Time to get after it."
msgstr "Buongiorno, %(username)s! È ora di darsi da fare."

#: apps/core/greetings.py:30
#, python-format
msgid ""
"Rise and grind, %(username)s — the weights aren't going to lift themselves."
msgstr "Su, %(username)s — i pesi non si sollevano da soli."

#: apps/core/greetings.py:31
#, python-format
msgid "Morning, %(username)s. Today's a great day for a new personal record."
msgstr ""
"Buongiorno, %(username)s. Oggi è un ottimo giorno per un nuovo record "
"personale."

#: apps/core/greetings.py:32
#, python-format
msgid "Good morning, %(username)s. Coffee first, then conquer the day."
msgstr ""
"Buongiorno, %(username)s. Prima il caffè, poi si conquista la giornata."

#: apps/core/greetings.py:36
#, python-format
msgid "Good afternoon, %(username)s! Keep the momentum going."
msgstr "Buon pomeriggio, %(username)s! Mantieni lo slancio."

#: apps/core/greetings.py:37
#, python-format
msgid "Hey %(username)s, halfway through the day and still standing — not bad."
msgstr ""
"Ehi %(username)s, metà giornata fatta e sei ancora in piedi — niente male."

#: apps/core/greetings.py:38
#, python-format
msgid "Afternoon, %(username)s. Perfect time to sneak in a workout."
msgstr "Buon pomeriggio, %(username)s. Il momento perfetto per un allenamento."

#: apps/core/greetings.py:39
#, python-format
msgid "Good afternoon, %(username)s. Lunch was earned, apparently."
msgstr ""
"Buon pomeriggio, %(username)s. A quanto pare il pranzo te lo sei meritato."

#: apps/core/greetings.py:43
#, python-format
msgid "Good evening, %(username)s! One more push before the day's done."
msgstr ""
"Buonasera, %(username)s! Un ultimo sforzo prima che finisca la giornata."

#: apps/core/greetings.py:44
#, python-format
msgid "Evening, %(username)s. A great time to log today's work."
msgstr ""
"Sera, %(username)s. Un buon momento per registrare l'allenamento di oggi."

#: apps/core/greetings.py:45
#, python-format
msgid "Hey %(username)s, the evening session hits different."
msgstr "Ehi %(username)s, l'allenamento serale ha tutto un altro sapore."

#: apps/core/greetings.py:46
#, python-format
msgid ""
"Good evening, %(username)s — finish the day stronger than you started it."
msgstr ""
"Buonasera, %(username)s — finisci la giornata più forte di come l'hai "
"iniziata."

#: apps/core/greetings.py:50
#, python-format
msgid "Still up, %(username)s? Respect the hustle."
msgstr "Ancora sveglio, %(username)s? Rispetto per l'impegno."

#: apps/core/greetings.py:51
#, python-format
msgid "Good night, %(username)s — recovery is part of the program too."
msgstr "Buonanotte, %(username)s — anche il recupero fa parte del programma."

#: apps/core/greetings.py:52
#, python-format
msgid "Burning the midnight oil, %(username)s? Even legends need sleep."
msgstr ""
"Stai facendo le ore piccole, %(username)s? Anche le leggende hanno bisogno "
"di dormire."

#: apps/core/greetings.py:53
#, python-format
msgid "Late night, %(username)s. Tomorrow's gains start with tonight's rest."
msgstr ""
"Tarda notte, %(username)s. I progressi di domani iniziano con il riposo di "
"stanotte."

#: apps/core/models.py:42
msgid ""
"Turns the backup-scheduler service's daily backup off without needing to "
"stop or remove that service."
msgstr ""
"Disattiva il backup giornaliero del servizio di pianificazione backup senza "
"doverlo arrestare o rimuovere."

#: apps/core/models.py:49
msgid "What time (UTC) the daily automatic backup runs at."
msgstr "A che ora (UTC) viene eseguito il backup automatico giornaliero."

#: apps/core/models.py:54
msgid ""
"How many backups to keep — older ones are deleted automatically after each "
"new one is created. 0 keeps every backup forever."
msgstr ""
"Quanti backup conservare: quelli più vecchi vengono eliminati "
"automaticamente dopo la creazione di ognuno nuovo. 0 conserva tutti i backup "
"per sempre."

#: apps/core/models.py:88
msgid ""
"Lets any signed-in user submit feedback from their profile page. Turning "
"this off only closes new submissions — feedback already on file stays "
"visible to staff."
msgstr ""
"Consente a qualsiasi utente registrato di inviare feedback dalla propria "
"pagina profilo. Disattivarlo chiude solo i nuovi invii — il feedback già "
"ricevuto resta visibile allo staff."

