msgid "Good morning, %(username)s! Time to get after it."
msgstr "Buongiorno, %(username)s! È ora di darsi da fare."

msgid "Rise and grind, %(username)s — the weights aren't going to lift themselves."
msgstr "Su, %(username)s — i pesi non si sollevano da soli."

msgid "Morning, %(username)s. Today's a great day for a new personal record."
msgstr "Buongiorno, %(username)s. Oggi è un ottimo giorno per un nuovo record personale."

msgid "Good morning, %(username)s. Coffee first, then conquer the day."
msgstr "Buongiorno, %(username)s. Prima il caffè, poi si conquista la giornata."

msgid "Good afternoon, %(username)s! Keep the momentum going."
msgstr "Buon pomeriggio, %(username)s! Mantieni lo slancio."

msgid "Hey %(username)s, halfway through the day and still standing — not bad."
msgstr "Ehi %(username)s, metà giornata fatta e sei ancora in piedi — niente male."

msgid "Afternoon, %(username)s. Perfect time to sneak in a workout."
msgstr "Buon pomeriggio, %(username)s. Il momento perfetto per un allenamento."

msgid "Good afternoon, %(username)s. Lunch was earned, apparently."
msgstr "Buon pomeriggio, %(username)s. A quanto pare il pranzo te lo sei meritato."

msgid "Good evening, %(username)s! One more push before the day's done."
msgstr "Buonasera, %(username)s! Un ultimo sforzo prima che finisca la giornata."

msgid "Evening, %(username)s. A great time to log today's work."
msgstr "Sera, %(username)s. Un buon momento per registrare l'allenamento di oggi."

msgid "Hey %(username)s, the evening session hits different."
msgstr "Ehi %(username)s, l'allenamento serale ha tutto un altro sapore."

msgid "Good evening, %(username)s — finish the day stronger than you started it."
msgstr "Buonasera, %(username)s — finisci la giornata più forte di come l'hai iniziata."

msgid "Still up, %(username)s? Respect the hustle."
msgstr "Ancora sveglio, %(username)s? Rispetto per l'impegno."

msgid "Good night, %(username)s — recovery is part of the program too."
msgstr "Buonanotte, %(username)s — anche il recupero fa parte del programma."

msgid "Burning the midnight oil, %(username)s? Even legends need sleep."
msgstr "Stai facendo le ore piccole, %(username)s? Anche le leggende hanno bisogno di dormire."

msgid "Late night, %(username)s. Tomorrow's gains start with tonight's rest."
msgstr "Tarda notte, %(username)s. I progressi di domani iniziano con il riposo di stanotte."

