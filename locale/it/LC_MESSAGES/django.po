#: apps/progression/engine.py:473
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g - more in reserve than planned, "
"adding %(increment)s kg."
msgstr ""
"RIR target %(target)s, effettivo %(actual)g - più margine del previsto, si "
"aggiungono %(increment)s kg."

#: apps/progression/engine.py:486
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g - notably closer to failure than "
"planned, easing back to %(deload)s kg."
msgstr ""
"RIR target %(target)s, effettivo %(actual)g - notevolmente più vicino al "
"cedimento del previsto, si allenta a %(deload)s kg."

#: apps/progression/engine.py:496
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g - close enough to plan, hold the "
"weight."
msgstr ""
"RIR target %(target)s, effettivo %(actual)g - abbastanza vicino al piano, "
"mantieni il peso."

