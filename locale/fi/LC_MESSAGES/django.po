msgstr ""
"Tavoite-RIR %(target)s, toteutunut %(actual)g - enemmän reserviä kuin "
"suunniteltu, lisätään %(increment)s kg."

#: apps/progression/engine.py:486
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g - notably closer to failure than "
"planned, easing back to %(deload)s kg."
msgstr ""
"Tavoite-RIR %(target)s, toteutunut %(actual)g - huomattavasti lähempänä "
"uupumusta kuin suunniteltu, kevennetään painoon %(deload)s kg."

#: apps/progression/engine.py:496
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g - close enough to plan, hold the "
"weight."
msgstr ""
"Tavoite-RIR %(target)s, toteutunut %(actual)g - riittävän lähellä "
"suunnitelmaa, pidetään sama paino."

