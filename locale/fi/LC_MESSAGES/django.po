msgid "Just want a quick number without setting anything up?"
msgstr "Haluatko vain nopean luvun ilman mitään käyttöönottoa?"

#: templates/nutrition/onboarding_body.html:22
msgid "Try the calculators"
msgstr "Kokeile laskureita"

#: templates/nutrition/onboarding_goal.html:6
