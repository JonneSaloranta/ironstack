msgid "Good morning, %(username)s! Time to get after it."
msgstr "Доброе утро, %(username)s! Пора действовать."

msgid "Rise and grind, %(username)s — the weights aren't going to lift themselves."
msgstr "Подъём, %(username)s — штанга сама себя не поднимет."

msgid "Morning, %(username)s. Today's a great day for a new personal record."
msgstr "Доброе утро, %(username)s. Сегодня отличный день для нового рекорда."

msgid "Good morning, %(username)s. Coffee first, then conquer the day."
msgstr "Доброе утро, %(username)s. Сначала кофе, потом покоряем день."

msgid "Good afternoon, %(username)s! Keep the momentum going."
msgstr "Добрый день, %(username)s! Не сбавляй темп."

msgid "Hey %(username)s, halfway through the day and still standing — not bad."
msgstr "Привет, %(username)s, день наполовину позади, а ты всё ещё держишься — неплохо."

msgid "Afternoon, %(username)s. Perfect time to sneak in a workout."
msgstr "Добрый день, %(username)s. Отличное время для тренировки."

msgid "Good afternoon, %(username)s. Lunch was earned, apparently."
msgstr "Добрый день, %(username)s. Обед, судя по всему, был заслуженным."

msgid "Good evening, %(username)s! One more push before the day's done."
msgstr "Добрый вечер, %(username)s! Ещё одно усилие перед концом дня."

msgid "Evening, %(username)s. A great time to log today's work."
msgstr "Вечер, %(username)s. Хорошее время, чтобы записать сегодняшнюю тренировку."

msgid "Hey %(username)s, the evening session hits different."
msgstr "Привет, %(username)s, вечерняя тренировка всегда особенная."

msgid "Good evening, %(username)s — finish the day stronger than you started it."
msgstr "Добрый вечер, %(username)s — закончи день сильнее, чем начал."

msgid "Still up, %(username)s? Respect the hustle."
msgstr "Всё ещё не спишь, %(username)s? Уважение за упорство."

msgid "Good night, %(username)s — recovery is part of the program too."
msgstr "Спокойной ночи, %(username)s — восстановление тоже часть программы."

msgid "Burning the midnight oil, %(username)s? Even legends need sleep."
msgstr "Не спишь допоздна, %(username)s? Даже легендам нужен сон."

msgid "Late night, %(username)s. Tomorrow's gains start with tonight's rest."
msgstr "Поздний вечер, %(username)s. Завтрашний прогресс начинается с сегодняшнего отдыха."

