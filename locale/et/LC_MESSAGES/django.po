#: apps/nutrition/suggestions.py:117
msgid ""
"Not enough logged weight yet - keep logging your weight regularly and check "
"back in a couple of weeks."
msgstr ""
"Kaalu pole veel piisavalt logitud - jätka kaalu regulaarset logimist ja "
"vaata uuesti paari nädala pärast."

#: apps/nutrition/suggestions.py:135
#, python-format
msgid ""
"Target: %(target)s kg/week. Actual trend: %(actual)s kg/week - on track."
