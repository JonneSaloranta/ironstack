msgstr "Manuaalne progressioon — sina kontrollid järgmist kaalu ja sihtmärki."

#: apps/progression/engine.py:192
#, python-format
msgid ""
"Missed the target %(streak)s sessions in a row at %(weight)s kg — even "
"maintenance loading should come down, to %(deload)s kg."
msgstr ""
"Sihtmärk jäi saavutamata %(streak)s korda järjest kaaluga %(weight)s kg — "
"isegi säilituskoormust tuleks vähendada, %(deload)s kg-ni."

#: apps/progression/engine.py:202
msgid "Maintenance — keeping the same load."
msgstr "Säilitamine — sama koormus jääb kehtima."

#: apps/progression/engine.py:220
#, python-format
msgid "Hit every rep last session at %(weight)s kg — adding %(increment)s kg."
msgstr ""
"Kõik kordused õnnestusid viimasel korral kaaluga %(weight)s kg — lisame "
"%(increment)s kg."

#: apps/progression/engine.py:232
#, python-format
msgid ""
"Missed target reps %(streak)s sessions in a row at %(weight)s kg — "
"recommending a deload to %(deload)s kg."
msgstr ""
"Korduste sihtmärk jäi saavutamata %(streak)s korda järjest kaaluga "
"%(weight)s kg — soovitatav on kergendada kaaluni %(deload)s kg."

#: apps/progression/engine.py:243
#, python-format
msgid ""
"Missed target reps last session at %(weight)s kg — try the same weight again "
"before increasing."
msgstr ""
"Korduste sihtmärk jäi saavutamata viimasel korral kaaluga %(weight)s kg — "
"proovi sama kaalu uuesti enne suurendamist."

#: apps/progression/engine.py:265
#, python-format
msgid ""
"Hit the top of your rep range on every set at %(weight)s kg — adding "
"%(increment)s kg and resetting to the bottom of the range."
msgstr ""
"Korduste vahemiku ülempiir täitus igas seerias kaaluga %(weight)s kg — "
"lisame %(increment)s kg ja naaseme vahemiku alampiirile."

#: apps/progression/engine.py:277
#, python-format
msgid ""
"Still within your rep range at %(weight)s kg — repeat the same weight and "
"aim for more reps next time."
msgstr ""
"Endiselt korduste vahemikus kaaluga %(weight)s kg — korda sama kaalu ja "
"püüdle järgmisel korral rohkemate korduste poole."

#: apps/progression/engine.py:291 apps/progression/engine.py:357
#, python-format
msgid ""
"Missed the bottom of your rep range %(streak)s sessions in a row at "
"%(weight)s kg — recommending a deload to %(deload)s kg."
msgstr ""
"Korduste vahemiku alampiir jäi saavutamata %(streak)s korda järjest kaaluga "
"%(weight)s kg — soovitatav on kergendada kaaluni %(deload)s kg."

#: apps/progression/engine.py:302 apps/progression/engine.py:368
#, python-format
msgid ""
"Missed the bottom of your rep range last session at %(weight)s kg — try the "
"same weight again."
msgstr ""
"Korduste vahemiku alampiir jäi saavutamata viimasel korral kaaluga "
"%(weight)s kg — proovi sama kaalu uuesti."

#: apps/progression/engine.py:331
#, python-format
msgid ""
"Hit the top of your rep range for %(streak)s sessions in a row at %(weight)s "
"kg — adding %(increment)s kg."
msgstr ""
"Korduste vahemiku ülempiir täitus %(streak)s korda järjest kaaluga "
"%(weight)s kg — lisame %(increment)s kg."

#: apps/progression/engine.py:343
#, python-format
msgid ""
"Within your rep range at %(weight)s kg — keep working toward the top of the "
"range before increasing."
msgstr ""
"Korduste vahemikus kaaluga %(weight)s kg — jätka tööd vahemiku ülempiiri "
"suunas enne suurendamist."

#: apps/progression/engine.py:402
msgid "a manually entered 1RM"
msgstr "käsitsi sisestatud 1RM"

#: apps/progression/engine.py:403
msgid "your latest estimated-1RM PR"
msgstr "sinu viimane hinnangulise 1RM rekord"

#: apps/progression/engine.py:404
msgid "a live estimate from your most recent set"
msgstr "värske hinnang su viimasest seeriast"

#: apps/progression/engine.py:414
msgid "No percentage target configured on this prescription."
msgstr "Sellele ettekirjutusele pole seatud protsendisihtmärki."

#: apps/progression/engine.py:423
msgid "No 1RM available yet — log a set first, or enter your 1RM manually."
msgstr ""
"1RM pole veel saadaval — logi kõigepealt seeria või sisesta oma 1RM käsitsi."

#: apps/progression/engine.py:431
#, python-format
msgid "%(percentage)s%% of %(one_rm)s kg (%(source)s) = %(suggested)s kg."
msgstr ""
"%(percentage)s%% kaalust %(one_rm)s kg (%(source)s) = %(suggested)s kg."

#: apps/progression/engine.py:461
msgid ""
"No RIR logged against a target yet — log sets with RIR to use this method."
msgstr ""
"RIR-i pole veel sihtmärgi suhtes logitud — kasuta seda meetodit, logides "
"seeriaid koos RIR-iga."

#: apps/progression/engine.py:473
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g — more in reserve than planned, "
"adding %(increment)s kg."
msgstr ""
"Sihtmärk RIR %(target)s, tegelik %(actual)g — rohkem reservi kui plaanitud, "
"lisame %(increment)s kg."

#: apps/progression/engine.py:486
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g — notably closer to failure than "
"planned, easing back to %(deload)s kg."
msgstr ""
"Sihtmärk RIR %(target)s, tegelik %(actual)g — märgatavalt lähemal "
"ammendumisele kui plaanitud, kergendame kaaluni %(deload)s kg."

#: apps/progression/engine.py:496
#, python-format
msgid ""
"Target RIR %(target)s, actual %(actual)g — close enough to plan, hold the "
"weight."
msgstr ""
"Sihtmärk RIR %(target)s, tegelik %(actual)g — plaanile piisavalt lähedal, "
"hoia sama kaalu."

