#: apps/nutrition/i18n_content.py:50
msgid "Fatburner lunch - Chicken & broccoli"
msgstr "Rasvapõletuse lõunasöök - kana ja brokoli"

#: apps/nutrition/i18n_content.py:51
msgid "Fatburner lunch - Tuna & spinach salad"
msgstr "Rasvapõletuse lõunasöök - tuunikala-spinatisalat"

#: apps/nutrition/i18n_content.py:52
msgid "Fatburner dinner - Salmon & greens"
msgstr "Rasvapõletuse õhtusöök - lõhe ja rohelised"

#: apps/nutrition/i18n_content.py:53
msgid "Fatburner dinner - Chicken & cottage cheese"
msgstr "Rasvapõletuse õhtusöök - kana ja kodujuust"

#: apps/nutrition/i18n_content.py:54
msgid "Balanced breakfast - Oats & yogurt"
msgstr "Tasakaalustatud hommikusöök - kaerahelbed ja jogurt"

#: apps/nutrition/i18n_content.py:55
msgid "Balanced breakfast - Eggs on toast"
msgstr "Tasakaalustatud hommikusöök - munad röstsaial"

#: apps/nutrition/i18n_content.py:56
msgid "Balanced lunch - Chicken & rice"
msgstr "Tasakaalustatud lõunasöök - kana ja riis"

#: apps/nutrition/i18n_content.py:57
msgid "Balanced lunch - Tuna sandwich"
msgstr "Tasakaalustatud lõunasöök - tuunikalavõileib"

#: apps/nutrition/i18n_content.py:58
msgid "Balanced dinner - Salmon & sweet potato"
msgstr "Tasakaalustatud õhtusöök - lõhe ja bataat"

#: apps/nutrition/i18n_content.py:59
msgid "Balanced dinner - Chicken & vegetables"
msgstr "Tasakaalustatud õhtusöök - kana ja köögiviljad"

#: apps/nutrition/i18n_content.py:64
msgid "Mix the oats into the yogurt, top with banana slices and peanut butter."
msgstr ""
"Sega kaerahelbed jogurti sisse, lisa peale banaaniviilud ja maapähklivõi."

#: apps/nutrition/i18n_content.py:66
msgid ""
"Fry or scramble the eggs, serve on toasted bread with peanut butter and a "
"drizzle of olive oil."
msgstr ""
"Prae või sega munad omletiks, serveeri röstsaiaga koos maapähklivõi ja tilga "
"oliiviõliga."

#: apps/nutrition/i18n_content.py:69
msgid ""
"Cook the chicken and rice, toss with olive oil, serve with steamed broccoli."
msgstr ""
"Küpseta kana ja riis, sega hulka oliiviõli, serveeri aurutatud brokoliga."

#: apps/nutrition/i18n_content.py:70
msgid ""
"Roast the sweet potato, flake in the tuna, drizzle with olive oil and serve "
"with spinach."
msgstr ""
"Küpseta bataat ahjus, purusta peale tuunikala, nirista peale oliiviõli ja "
"serveeri spinatiga."

#: apps/nutrition/i18n_content.py:71
msgid ""
"Pan-sear the salmon, serve over rice with steamed broccoli and a little "
"olive oil."
msgstr ""
"Prae lõhe pannil, serveeri riisi peal koos aurutatud brokoli ja pisut "
"oliiviõliga."

#: apps/nutrition/i18n_content.py:72
msgid ""
"Roast the chicken and sweet potato together, top with crushed almonds and "
"olive oil."
msgstr ""
"Küpseta kana ja bataat koos ahjus, lisa peale purustatud mandlid ja "
"oliiviõli."

#: apps/nutrition/i18n_content.py:73
msgid ""
"Scramble the eggs with the spinach, serve with cottage cheese on the side."
msgstr "Sega munad spinatiga praepannil, serveeri kõrvale kodujuustuga."

#: apps/nutrition/i18n_content.py:74
msgid "Top the yogurt with sliced banana and a few crushed almonds."
msgstr "Lisa jogurtile banaaniviilud ja mõned purustatud mandlid peale."

#: apps/nutrition/i18n_content.py:75
msgid ""
"Grill the chicken, steam the broccoli, finish with a light drizzle of olive "
"oil."
msgstr "Grilli kana, auruta brokoli, lõpeta kerge oliiviõli piserdusega."

#: apps/nutrition/i18n_content.py:76
msgid "Toss the tuna with the spinach and a small drizzle of olive oil."
msgstr "Sega tuunikala spinatiga ja väikese koguse oliiviõliga."

#: apps/nutrition/i18n_content.py:77
msgid "Bake the salmon, serve with steamed broccoli and spinach."
msgstr "Küpseta lõhe ahjus, serveeri aurutatud brokoli ja spinatiga."

#: apps/nutrition/i18n_content.py:78
msgid "Grill the chicken, serve with cottage cheese and wilted spinach."
msgstr "Grilli kana, serveeri kodujuustu ja hautatud spinatiga."

#: apps/nutrition/i18n_content.py:79
msgid "Mix the oats into the yogurt and top with sliced banana."
msgstr "Sega kaerahelbed jogurti sisse ja lisa peale banaaniviilud."

#: apps/nutrition/i18n_content.py:80
msgid ""
"Fry or scramble the eggs, serve on toasted bread with a little olive oil."
msgstr ""
"Prae või sega munad omletiks, serveeri röstsaiaga koos pisut oliiviõliga."

#: apps/nutrition/i18n_content.py:81
msgid "Cook the chicken and rice, serve with steamed broccoli and olive oil."
msgstr "Küpseta kana ja riis, serveeri aurutatud brokoli ja oliiviõliga."

#: apps/nutrition/i18n_content.py:82
msgid "Mix the tuna with the spinach, serve between slices of toasted bread."
msgstr "Sega tuunikala spinatiga, serveeri röstsaia viilude vahel."

#: apps/nutrition/i18n_content.py:83
msgid "Bake the salmon and sweet potato, serve with wilted spinach."
msgstr "Küpseta lõhe ja bataat ahjus, serveeri hautatud spinatiga."

#: apps/nutrition/i18n_content.py:84
msgid ""
"Roast the chicken with the broccoli and sweet potato, finish with olive oil."
msgstr "Küpseta kana koos brokoli ja bataadiga ahjus, lõpeta oliiviõliga."

