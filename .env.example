# Copy to .env and fill in real values. Never commit the actual .env file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=true

# PostgreSQL
POSTGRES_DB=ironstack
POSTGRES_USER=ironstack
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
