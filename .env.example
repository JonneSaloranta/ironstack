# Copy to .env and fill in real values. Never commit the actual .env file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
# Comma-separated bare hostnames only — no "http://"/"https://" scheme,
# no path, no port. A value like "https://example.com" will never match
# any real request's Host header, and every request to this instance
# (including via a reverse proxy/Cloudflare) will 400 with no obvious
# error on screen. Include every hostname/IP you actually reach this
# instance by (e.g. "example.com,192.168.1.10").
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=true
# Set to false to close public self-service registration once your
# intended users all have accounts (docs/SECURITY.md).
DJANGO_SIGNUP_ENABLED=true
# Set to false once every intended user has an Authentik-linked
# account (below) and you want Authentik as the only way in. Also
# closes signup and password reset — see docs/SECURITY.md "Single
# sign-on (Authentik / OIDC)". /admin/ keeps its own separate login
# either way, as a break-glass path.
DJANGO_PASSWORD_LOGIN_ENABLED=true

# Authentik single sign-on (docs/SECURITY.md "Single sign-on
# (Authentik / OIDC)") — entirely optional; leave AUTHENTIK_URL unset
# and this app behaves exactly as it did before this existed. Create
# an "OAuth2/OpenID Provider" for this app in Authentik's admin
# interface (Applications → Providers), with redirect URI
# "<this app's own base URL>/oidc/callback/", then an Application
# using that provider, and fill in the values below from it.
# AUTHENTIK_URL=https://auth.example.com
# AUTHENTIK_CLIENT_ID=change-me
# AUTHENTIK_CLIENT_SECRET=change-me
# Only needed if this app's own container/server can't reach
# AUTHENTIK_URL itself (e.g. Authentik runs as a separate Docker stack
# reachable from here only via an internal network hostname) — see
# config.settings.base's own comment on AUTHENTIK_INTERNAL_URL.
# Defaults to AUTHENTIK_URL; most deployments never need to set this.
# AUTHENTIK_INTERNAL_URL=http://authentik-server:9000
# Must match the slug the Application above was actually created
# with in Authentik.
# AUTHENTIK_APPLICATION_SLUG=ironstack
# Optional: an Authentik group name a user must belong to for "Log in
# with Authentik" to actually let them in — matters if this Authentik
# instance also authenticates other, unrelated apps, where "has an
# Authentik account at all" isn't the same as "should have IronStack
# access". Defense in depth alongside (not instead of) restricting the
# Application itself in Authentik's own admin UI to the same group.
# AUTHENTIK_REQUIRED_GROUP=ironstack-users

# Web Push notifications (docs/SECURITY.md "Web Push notifications")
# — entirely optional; leave these unset and this app behaves exactly
# as it did before this existed (no "Notifications" card on the
# profile page, no push ever sent). Generate a keypair with
# `docker compose exec web python manage.py generate_vapid_keys` and
# paste its two printed lines below — both must stay exactly as
# printed (base64url, no PEM headers, single line each); don't
# generate these any other way. VAPID_ADMIN_EMAIL is any real contact
# address, never shown to end users.
# VAPID_PUBLIC_KEY=change-me
# VAPID_PRIVATE_KEY=change-me
# VAPID_ADMIN_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=ironstack
POSTGRES_USER=ironstack
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email — required for password reset to actually deliver anywhere,
# and for error-report emails to DJANGO_ADMINS below (docs/SECURITY.md
# "Email"). Leave DJANGO_EMAIL_HOST unset to fall back to logging
# emails to the console instead of sending them.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=you@example.com
# DJANGO_EMAIL_HOST_PASSWORD=change-me
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=IronStack <noreply@example.com>

# Who gets emailed on an uncaught server error, once DJANGO_EMAIL_HOST
# above is actually configured. Format: "Name:email,Name2:email2".
# DJANGO_ADMINS=Jonne:jonne@example.com

# The address shown to a user as "who runs this instance, contact them
# about your data" in the privacy notice (login/signup pages, Profile)
# — a public-facing contact, not the same thing as DJANGO_ADMINS above
# (that's Django's own uncaught-exception mailing list). No effect on
# email delivery either way; leave unset and the notice just doesn't
# show a contact address.
# DJANGO_ADMIN_CONTACT_EMAIL=jonne@example.com

# Automatic daily backups (docs/BACKUP.md) — the `backup-scheduler`
# service in docker-compose.yml. UTC hour (0-23) to run at. Only seeds
# BackupSettings' initial value on first read — once that row exists,
# change the hour (and enabled/retention) from Profile → Administration
# → Backups or /admin/ instead; editing this afterward does nothing.
BACKUP_HOUR=3

# Which published image tag docker-compose.yml's `web`/`backup-scheduler`
# pull (ghcr.io/jonnesaloranta/ironstack:<tag>) — .github/workflows/ci.yml
# publishes both `latest` and the repo's own VERSION file's value (e.g.
# "1.1.0") on every push to master. Leave unset to always run the most
# recently published build, or pin a specific released version here.
# IRONSTACK_IMAGE_TAG=latest
